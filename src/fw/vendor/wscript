def configure(conf):
    if conf.is_silk():
        conf.env.append_unique('DEFINES', 'STM32F412xG')
        # The CMSIS device header dispatches on the exact package macro
        # (STM32F412Rx/Cx/Vx/Zx), not the density-only STM32F412xG the rest
        # of this tree uses; Rx (64-pin) is the common choice for wearables
        # and is electrically identical to the others for our purposes.
        conf.env.append_unique('DEFINES', 'STM32F412Rx')
    elif conf.env.MICRO_FAMILY == 'STM32F4':
        conf.env.append_unique('DEFINES', 'STM32F429_439xx')
    elif conf.env.MICRO_FAMILY == 'STM32F7':
        conf.env.append_unique('DEFINES', 'STM32F779xx')
    conf.recurse('FreeRTOS')
    if conf.capability('HAS_JAVASCRIPT'):
        conf.recurse('jerryscript')

def build(bld):
    bld.recurse('tinymt32')
    bld.recurse('FreeRTOS')
    bld.recurse('nanopb')

    if bld.env.MICRO_FAMILY == 'STM32F4':
        if bld.is_silk():
            # STM32F412 (silk) lacks CRYP, HASH, DAC, DCMI and FSMC
            # entirely -- confirmed by their absence from the real,
            # current STMicroelectronics/cmsis_device_f4 stm32f412rx.h
            # device header (no CRYP_TypeDef/HASH_TypeDef/DAC_TypeDef/
            # DCMI_TypeDef/FSMC_Bank2_TypeDef etc.) -- so the StdPeriph
            # drivers for them can't build against it (they target
            # bigger F4 parts that do have these peripherals, like
            # F437/F439). Matches the non-silk branch below, which
            # already excludes fsmc.c for the same reason on those
            # other boards.
            excludes = ['**/stm32f4xx_fsmc.c',
                        '**/stm32f4xx_cryp*.c',
                        '**/stm32f4xx_hash*.c',
                        '**/stm32f4xx_dac.c',
                        '**/stm32f4xx_dcmi.c']
        else:
            excludes = ['**/stm32f4xx_fsmc.c']

        stm32_sources = bld.path.ant_glob('STM32F4xx_StdPeriph_Driver/src/*.c',
                                          excl=excludes)

        stm32_includes = ['CMSIS/Include',
                          'CMSIS/Device/ST/STM32F4xx/Include',
                          'STM32F4xx_StdPeriph_Driver/inc']

    elif bld.env.MICRO_FAMILY == 'STM32F2':
        stm32_sources = bld.path.ant_glob('STM32F2xx_StdPeriph_Driver/src/*.c')

        stm32_includes = ['CMSIS/Include',
                          'CMSIS/Device/ST/STM32F2xx/Include',
                          'STM32F2xx_StdPeriph_Driver/inc']

    elif bld.env.MICRO_FAMILY == 'STM32F7':
        stm32_sources = bld.path.ant_glob('stm32f7haxx_stdperiph/*.c')

        stm32_includes = ['CMSIS/Include',
                          'CMSIS/Device/ST/STM32F7xx/Include',
                          'stm32f7haxx_stdperiph']
    else:
        bld.fatal("No microcontroller family set for this build")

    bld.stlib(source=stm32_sources,
              target='stm32_stdlib',
              use='pblibc',
              # Parent dir is included for stm32fxxx_conf.h
              includes=stm32_includes + ['..'],
              export_includes=stm32_includes)

