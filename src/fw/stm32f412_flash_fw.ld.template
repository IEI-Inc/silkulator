/*
 * Reconstructed MCU-specific linker script for the silk (Pebble 2 / STM32F412)
 * firmware build. This file does not ship in the public google/pebble dump
 * (it was omitted, not merely license-stripped like the vendor libraries),
 * so it was written from scratch here to satisfy the contract documented
 * in src/fw/fw_common.ld: define FLASH, KERNEL_RAM, APP_RAM, WORKER_RAM,
 * plus REGION_ISR_STACK / REGION_KERNEL_STACKS / REGION_KERNEL_HEAP (as
 * aliases). Values are substituted by src/fw/wscript's _generate_memory_layout().
 *
 * Modeled directly on platform/silk/boot/src/stm32f_flash_boot.ld.in (the
 * real, shipped bootloader linker script for this same chip) for style and
 * on the real STM32F412xG memory map (flash at 0x08000000, SRAM at
 * 0x20000000, 256K total) for the numbers that aren't passed in.
 */

MEMORY
{
    FLASH      (rx)  : ORIGIN = @FW_FLASH_ORIGIN@, LENGTH = @FW_FLASH_LENGTH@
    KERNEL_RAM (xrw) : ORIGIN = @KERNEL_RAM_ADDR@, LENGTH = @KERNEL_RAM_SIZE@
    APP_RAM    (xrw) : ORIGIN = @APP_RAM_ADDR@, LENGTH = @APP_RAM_SIZE@
    WORKER_RAM (xrw) : ORIGIN = @WORKER_RAM_ADDR@, LENGTH = @WORKER_RAM_SIZE@
}

/* fw_common.ld asks for these three region names; on silk there's no
 * separate CCM/TCM bank carved out for them like there is on snowy, so they
 * all simply alias the kernel's own RAM region. */
REGION_ALIAS("REGION_ISR_STACK", KERNEL_RAM)
REGION_ALIAS("REGION_KERNEL_STACKS", KERNEL_RAM)
REGION_ALIAS("REGION_KERNEL_HEAP", KERNEL_RAM)

/* src/fw/kernel/memory_layout.c references these as extern symbols, to
 * build the MPU region that covers the chip's entire internal flash
 * (src/fw/drivers/mpu.c's get_size_field() walks size=32,64,128,...
 * doubling until it matches region->size, and REQUIRES an exact power
 * of two -- it has no other way to terminate).
 *
 * Earlier this aliased __FLASH_start__/__FLASH_size__ straight to this
 * script's own FLASH region (ORIGIN(FLASH)/LENGTH(FLASH)), copying the
 * real coredevices/pebbleos fork's fw/linker/memory.ld naming -- but
 * that fork's FLASH region *is* the whole chip, whereas here FLASH is
 * just the firmware's own sub-region carved out after the bootloader
 * and image header (see FW_FLASH_ORIGIN/FW_FLASH_LENGTH above: origin
 * is chip-start + bootloader_size, length is flash_size - bootloader_
 * size). LENGTH(FLASH) is therefore something like 0xfc000 (1024K minus
 * the 16K bootloader) -- not a power of two -- so get_size_field()'s
 * loop could never terminate normally, and silently spun forever (no
 * assert output ever made it out either) the moment memory_layout_setup
 * _mpu() tried to register that region, hanging boot immediately after
 * task_init() with no crash and no further dbgserial output.
 *
 * The fix: use the *whole-chip* FLASH_ORIGIN/FLASH_SIZE substitutions
 * that src/fw/wscript's _generate_memory_layout() already computes and
 * passes to every board's linker template (flash_origin = chip base,
 * e.g. 0x08000000; flash_size = the chip's full power-of-two capacity,
 * e.g. 1024K on real silk hardware, or 4M here under --qemu) -- matching
 * what pebbleos's memory.ld actually does (CONFIG_FLASH_BASE/_SIZE, the
 * SoC's real base/size, not its own FLASH region's ORIGIN()/LENGTH()). */
__FLASH_start__ = @FLASH_ORIGIN@;
__FLASH_size__ = @FLASH_SIZE@;

@BOOTLOADER_SYMBOLS@

/* vim: set filetype=ld: */
